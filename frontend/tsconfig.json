{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    // noCheck sigue activo: reactivar el typecheck completo destapa ~219 errores
    // de tipos preexistentes (params de API mal nombrados, enums TaskStatus, tipos
    // `never` del refactor APIListResponse). Es una migración gradual (#115), no un
    // flip de flag; hacerlo sin corregirlos rompería el build/CI. Se corrigen por
    // carpeta y luego se elimina esta línea.
    "noCheck": true,

    /* Coexistencia con JS — migración gradual #115 */
    "allowJs": true,
    "checkJs": false,

    /* Linting (estricto pero relajado para empezar) */
    "strict": false,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.test.tsx"]
}
