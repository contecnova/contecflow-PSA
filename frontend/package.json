{
  "name": "contecflow-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@tanstack/react-query": "^5.45.0",
    "@xyflow/react": "^12.10.2",
    "axios": "^1.15.2",
    "bpmn-js": "^18.16.1",
    "d3": "^7.9.0",
    "d3-sankey": "^0.12.3",
    "date-fns": "^3.6.0",
    "dexie": "^4.0.8",
    "echarts": "^5.5.1",
    "echarts-for-react": "^3.0.2",
    "html2canvas": "^1.4.1",
    "livekit-client": "^2.18.9",
    "lucide-react": "^0.394.0",
    "plotly.js": "^2.35.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^2.2.3",
    "react-plotly.js": "^2.6.0",
    "react-router-dom": "^6.23.1",
    "react-window": "^1.8.10",
    "recharts": "^2.12.7",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.30",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/parser": "^7.28.4",
    "@eslint/js": "^9.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-plotly.js": "^2.6.4",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.0.2",
    "playwright": "^1.59.1",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.4",
    "type-coverage": "^2.29.7",
    "typescript": "^6.0.3",
    "vite": "^7.1.12",
    "vitest": "^4.1.5",
    "workbox-window": "^7.1.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "node scripts/check_strict.mjs",
    "lint:a11y": "npm run lint:a11y:report && npm run lint:a11y:strict:core",
    "lint:a11y:report": "node scripts/a11y_audit.mjs",
    "lint:a11y:strict:core": "eslint src/main.tsx src/App.tsx src/context/AuthContext.tsx src/components/layout/Breadcrumbs.tsx src/components/ui/IconButton.tsx --ext .ts,.tsx --max-warnings 0",
    "validate:jsx": "node validate.cjs",
    "check:i18n": "node scripts/check_i18n.mjs",
    "check:i18n:no-new-debt": "node scripts/check_i18n_no_new_debt.mjs",
    "check:i18n:strict": "npm run check:i18n",
    "check:i18n:ci": "npm run check:i18n:no-new-debt",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:jsdom": "vitest --environment jsdom",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "install:playwright": "npx playwright install --with-deps",
    "type:coverage": "type-coverage --at-least 75 --ignore-catch --detail",
    "quality:p3": "npm run typecheck && npm run type:coverage && npm run lint:a11y:report",
    "check:i18n:coverage": "node scripts/check_i18n_coverage.mjs",
    "i18n:gap": "node scripts/i18n_gap.mjs",
    "check:chunks": "node scripts/check_heavy_chunks.mjs",
    "check:i18n:dup": "node scripts/check_i18n_duplicates.mjs",
    "i18n:missing": "node scripts/i18n_missing.mjs"
  }
}
