# ══════════════════════════════════════════════════════════════════════════════
# Contecflow PSA — Variables de entorno
# Copia este archivo a .env y rellena los valores
# NUNCA comitas .env al repositorio — está en .gitignore
# ══════════════════════════════════════════════════════════════════════════════
#
# Convención de etiquetas (ver docs/CONFIG_MIGRATION_INVENTORY.md):
#
#   [bootstrap]   Solo env. La app no puede arrancar / cambiarlo sin redeploy.
#                 DATABASE_URL, SECRET_KEY, SENTRY_DSN, OTEL_*, METRICS_ENABLED,
#                 ALLOWED_ORIGINS, KMS_*, RATE_LIMIT_DEFAULT, WEBAUTHN_RP_ID, KEY_ROTATION_*.
#                 Cambios requieren reinicio del proceso.
#
#   [ui-managed]  Editable desde la UI (Settings → Sistema → Config. dinámica
#                 o → Credenciales). El valor en .env solo se usa si no hay
#                 override en BD. Si modificas .env para uno de estos settings
#                 y la BD tiene una fila, GANA la BD. Las credenciales se cifran
#                 en reposo (Fernet/HKDF + opcional AWS KMS).
#
#   [keep-env]    No bootstrap pero pragmáticamente env-only (URLs públicas
#                 estables como API bases, OAuth endpoints, docs URLs).
#
# ══════════════════════════════════════════════════════════════════════════════

# ── Base de datos [bootstrap] ─────────────────────────────────────────────────
# SQLite (desarrollo):
DATABASE_URL=sqlite:///./contecflow.db
# PostgreSQL (producción):
# DATABASE_URL=postgresql://contecflow:PASSWORD@localhost:5432/contecflow

# ── Seguridad [bootstrap] ──────────────────────────────────────────────────────
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_run_python_secrets_token_hex_32_to_generate
ALGORITHM=HS256
# Access/refresh — [ui-managed] (editable en Settings → Config. dinámica → password_policy si quisieras moverlos, hoy aún bootstrap):
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
SUPERADMIN_EMAIL=admin@company.com
SUPERADMIN_PASSWORD=CHANGE_ME_strong_password
CLIENT_PORTAL_SECRET=CHANGE_ME_generate_a_secure_random_key
# WEBHOOK_SECRET [ui-managed] — gestionable en Settings → Credenciales → Webhooks
WEBHOOK_SECRET=CHANGE_ME_generate_a_secure_random_key

# ── Inbound webhook authentication (fail-closed: empty ⇒ requests rejected) ────
# Jira: shared secret sent in the X-Atlassian-Webhook-Token header (configure a
# Jira automation rule), or an HMAC-SHA256 of the body in X-Hub-Signature-256.
JIRA_WEBHOOK_SECRET=
# DocuSign Connect HMAC key (Connect → "Include HMAC Signature") — verifies the
# X-DocuSign-Signature-N headers on inbound e-signature webhooks.
DOCUSIGN_CONNECT_HMAC_KEY=
# Adobe Sign authenticates webhooks via the X-AdobeSign-ClientId header, which
# must equal ADOBE_SIGN_CLIENT_ID below.

# ── Infrastructure provisioning (Terraform / Ansible) ──────────────────────────
# OFF by default. When enabled, every workdir/playbook/var_file/inventory path
# from tenant config must resolve INSIDE PROVISIONING_ROOT_DIR (a directory of
# vetted IaC modules/playbooks you control). Prevents RCE via attacker-staged
# playbooks. Leave disabled unless you operate a hardened provisioning runner.
PROVISIONING_ENABLED=0
PROVISIONING_ROOT_DIR=

# ── CORS [bootstrap] ───────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── SSO OAuth [keep-env] ──────────────────────────────────────────────────────
ALLOW_LOCAL_LOGIN=true
MICROSOFT_OAUTH_BASE=https://login.microsoftonline.com
GOOGLE_OAUTH_BASE=https://accounts.google.com
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token


# ── AI providers (opcional) — URLs [keep-env] · API keys [ui-managed] ─────────
# URLs base de proveedores: estables y públicas, no se gestionan por UI.
ANTHROPIC_API_URL=https://api.anthropic.com/v1
OPENAI_API_URL=https://api.openai.com/v1
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
DEEPSEEK_API_URL=https://api.deepseek.com/v1
GROQ_API_URL=https://api.groq.com/openai/v1
MISTRAL_API_URL=https://api.mistral.ai/v1
OLLAMA_BASE_URL=http://localhost:11434
AZURE_OPENAI_API_URL=https://YOUR_RESOURCE.openai.azure.com/openai/deployments/YOUR_DEPLOYMENT
# ── Proveedor de IA del despliegue (AGNÓSTICO) ───────────────────────────────
#
# La aplicación soporta ocho proveedores y la resolución tiene tres escalones:
#
#     proveedor de la organización (BD) → proveedor global (BD) → .env
#
# La base de datos manda porque un despliegue multi-empresa necesita un
# proveedor por organización, y eso un fichero de entorno no lo puede expresar.
# Estas variables son el último escalón: con ellas, un despliegue de un solo
# cliente se configura entero sin abrir la aplicación.
#
#   AI_PROVIDER   anthropic | openai | gemini | deepseek | ollama | groq |
#                 mistral | azure
#   AI_API_KEY    la clave del proveedor elegido (Ollama no la necesita)
#   AI_MODEL      opcional; si se omite, el del catálogo del proveedor
#   AI_BASE_URL   sólo para Ollama o Azure con endpoint propio
#
# Ejemplo para Gemini:
#   AI_PROVIDER=gemini
#   AI_API_KEY=AIza...
#   AI_MODEL=gemini-2.0-flash
#
# Ejemplo para un Ollama local:
#   AI_PROVIDER=ollama
#   AI_BASE_URL=http://localhost:11434
#   AI_MODEL=llama3
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# ── Claves heredadas, por proveedor ──────────────────────────────────────────
# API keys: gestionables en Settings → Credenciales → AI providers (cifradas).
# Estos valores en .env actúan como fallback si la BD está vacía.
# ANTHROPIC_API_KEY=   <- alias heredado: si no hay AI_PROVIDER, resuelve a anthropic
# OPENAI_API_KEY=
# Modelo IA de fallback [ui-managed] — Settings → Config. dinámica → semantic/locale (todavía no expuesto, env vale por ahora).
CONTECFLOW_AI_MODEL=claude-haiku-4-5

# ── Contabilidad (opcional) [keep-env] ────────────────────────────────────────
XERO_API_BASE=https://api.xero.com/api.xro/2.0
QB_API_BASE=https://quickbooks.api.intuit.com/v3/company

# ── URLs [bootstrap] ──────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api/v1
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ── Storage [bootstrap] ───────────────────────────────────────────────────────
PDF_STORAGE_PATH=./storage/pdfs

# ── AWS S3 [ui-managed] — Settings → Credenciales → AWS S3 ────────────────────
# Vacío deshabilita S3 (usa almacenamiento local). access_key/secret_key se cifran en BD.
AWS_S3_BUCKET=
AWS_REGION=eu-west-1
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
S3_URL_EXPIRATION_HOURS=24

# ── Notifications [ui-managed] — Settings → Credenciales → Slack + SMTP ──────
SLACK_WEBHOOK_URL=
NOTIFICATION_EMAIL_FROM=alerts@contecflow.local

# ── SMTP de salida [ui-managed] — Settings → Credenciales → SMTP ──────────────
# CUIDADO con el nombre de la contrasena: el ajuste es SMTP_PASS, no
# SMTP_PASSWORD. Dos modulos leian el segundo, que no existe, asi que
# `server.login()` no se llamaba nunca y TODOS los avisos por correo salian sin
# autenticar. Auditoria 2026-08.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── SMS / multicanal via Twilio [ui-managed] ──────────────────────────────────
# Sin estos tres el envio de SMS no se podia configurar de ninguna manera: el
# codigo los leia con `getattr` y no estaban declarados, asi que devolvian
# siempre None. Auditoria 2026-08.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Portal de cliente: caducidades [runtime] ──────────────────────────────────
# Horas de vida del token de sesion del portal y de un enlace compartido. Son
# valores de SEGURIDAD y estaban fijos en 72 h sin forma de bajarlos.
CLIENT_TOKEN_EXPIRE_HOURS=72
PORTAL_SHARE_LINK_EXPIRE_HOURS=72
# Algoritmo de firma de los tokens del portal. HS256 es correcto con clave
# simetrica; se declara para que este en un solo sitio.
JWT_ALGORITHM=HS256

# ── Portal de desarrollador [runtime] ─────────────────────────────────────────
# Iteraciones de PBKDF2 al derivar el secreto de una app. Parametro de seguridad
# que hay que poder SUBIR con el tiempo sin tocar codigo.
PBKDF2_ITERATIONS=260000
# Cuota de aplicaciones por usuario.
MAX_APPS_PER_USER=10

# ── Cortacircuitos de webhooks [runtime] ──────────────────────────────────────
# Fallos seguidos de un webhook antes de dejar de intentarlo.
WEBHOOK_CB_THRESHOLD=5

# ── Estimacion de ingresos por IA [runtime] ───────────────────────────────────
# Tarifa horaria de respaldo cuando el proyecto no trae tarifa. Es una cifra de
# NEGOCIO y estaba escrita en duro a 85,0.
AI_REVENUE_HOURLY_RATE_FALLBACK=85.0

# ── Almacenamiento local de subidas [deploy] ──────────────────────────────────
# Directorio raiz de los ficheros subidos cuando no se usa S3.
UPLOAD_DIR=uploads

# ── Colaboracion: llamadas [runtime] ─────────────────────────────────────────
# Topes por usuario y minuto de llamadas iniciadas y de uniones a una llamada, y
# cuantas llamadas trae el historial de una conversacion. Estaban en duro en el
# codigo (8, 20 y 50). Auditoria 2026-08.
COLLAB_CALL_START_PER_MIN=8
COLLAB_CALL_JOIN_PER_MIN=20
COLLAB_CALL_HISTORY_LIMIT=50
# Peticiones por minuto de un webhook entrante (estaba en duro a 120).
COLLAB_WEBHOOK_INCOMING_PER_MIN=120
# Eventos que se piden a CADA proveedor en la vista de calendario agregada
# (estaba en duro a 20). Es el tope por proveedor, no el total: con Google y
# M365 conectados la respuesta puede traer el doble. Auditoria 2026-08.
COLLAB_CALENDAR_MAX_EVENTS=20
# Mensajes por minuto que un usuario del portal puede publicar en el chat
# (estaba en duro a 25). Auditoria 2026-08.
COLLAB_PORTAL_MESSAGE_PER_MIN=25

# Cuantos cambios puntua como maximo una pasada de POST /sd/changes/batch-score.
# Auditoria 2026-08: cargaba TODOS los cambios pendientes sin puntuar, sin tope,
# y cada uno cuesta un scoring completo (elementos de configuracion, sus
# dependencias, tickets abiertos sobre ellos, historial de incidencias) mas un
# commit. Sin tope, una cola acumulada convierte una peticion HTTP en un trabajo
# de lote de duracion desconocida. La respuesta indica `truncated`.
CHANGE_BATCH_SCORE_MAX=100

# Cuantos tickets abiertos analiza como maximo GET /sd/predictive/stats.
# Auditoria 2026-08: cargaba TODOS los tickets abiertos como objetos del ORM,
# sin tope, y gastaba 12 consultas por ticket entre sus dos predictores
# —medido: 1 ticket 12 consultas, 5 tickets 60, 20 tickets 240—. Con 500
# abiertos serian 6.000 consultas en una peticion. La respuesta indica
# `analyzed_tickets` y `truncated` para que un numero acotado no se lea como
# completo. Subirlo solo tiene sentido si los predictores dejan de hacer N+1.
PREDICTIVE_STATS_MAX_TICKETS=200

# ── Aislamiento multi-tenant [deploy] ────────────────────────────────────────
# Sella la organizacion de la sesion en las filas nuevas que no la traigan.
# Auditoria 2026-08: 195 de los 376 modelos con esa columna no se construian
# NUNCA con ella, y el filtro de tenant es `organization_id == org`, asi que
# esas filas no las veia su propia organizacion. Comprobado: se creaba un ciclo
# de evaluacion y GET /performance/cycles devolvia cero a su propio creador; una
# notificacion se creaba y el listado devolvia vacio. Poner a 0 solo para
# aislar un problema.
TENANT_AUTO_STAMP_ON_INSERT=1
# Filtro global de aislamiento por organizacion (do_orm_execute). Poner a 0 solo
# para aislar un problema: sin el, una consulta ORM sin filtro explicito
# devuelve filas de todos los clientes.
TENANT_AUTO_FILTER_GLOBAL=1

# ── Locale / jornada [ui-managed] — Settings → Config. dinámica → locale ─────
DEFAULT_IMPUTATION_LOCKOUT_DAYS=14
DEFAULT_TIMEZONE=Europe/Madrid
DEFAULT_LANGUAGE=es
DEFAULT_CURRENCY=EUR

# ── Reglas de negocio [ui-managed] — Settings → Config. dinámica ──────────────
DEFAULT_TAX_RATE=21.0
# Política de contraseñas [ui-managed] → Config. dinámica → password_policy
MIN_PASSWORD_LENGTH=8
# Contraseña inicial de usuarios demo [bootstrap] — SOLO para el seed de dev/demo.
# Placeholder a propósito: el validador de config rechaza los valores "CHANGE_ME_*",
# así que debes fijar una contraseña real antes de sembrar. No la reutilices en prod.
# (La importación masiva de usuarios NO usa este valor: genera una contraseña aleatoria por usuario.)
DEFAULT_USER_PASSWORD=CHANGE_ME_dev_seed_password
DEFAULT_WORKING_HOURS_PER_DAY=8.0
DEFAULT_WEEKLY_CAPACITY_HOURS=40.0
DEFAULT_VACATION_DAYS_PER_YEAR=23

# ── SLA (horas) [ui-managed] — Settings → Config. dinámica → SLA ─────────────
SLA_P1_RESPONSE_HOURS=1.0
SLA_P1_RESOLUTION_HOURS=4.0
SLA_P2_RESPONSE_HOURS=4.0
SLA_P2_RESOLUTION_HOURS=8.0
SLA_P3_RESPONSE_HOURS=8.0
SLA_P3_RESOLUTION_HOURS=24.0
SLA_P4_RESPONSE_HOURS=24.0
SLA_P4_RESOLUTION_HOURS=72.0

# ── Entorno [bootstrap] ────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
DEFAULT_PROJECT_TYPE=consulting
DEFAULT_BILLING_TYPE=time_material

# ── Scheduler safety [bootstrap] — bind-time on APScheduler ──────────────────
# No activar ambos a la vez (ejecuciones duplicadas).
ENABLE_APSCHEDULER=1
ENABLE_CELERY_BEAT=0
FAIL_ON_DUAL_SCHEDULER=1

# ══════════════════════════════════════════════════════════════════════════════
# STACK DOCKER (docker-compose.yml)
#
# El compose declara estas variables con `${VAR:?}`: si falta alguna, `up` aborta
# con un mensaje claro en lugar de arrancar con un valor por defecto silencioso.
# `./setup.sh` las rellena solo (generando los secretos una vez y guardándolos
# aquí), así que en desarrollo no hay que tocar nada.
#
# Modos:
#   docker compose up -d                  → sólo infraestructura (desarrollo:
#                                           la app corre en local con uvicorn)
#   docker compose --profile app up -d    → producción: migrate + api + worker +
#                                           beat + web
#   docker compose --profile observability up -d   → + prometheus y exporters
# ══════════════════════════════════════════════════════════════════════════════

# ── PostgreSQL [bootstrap] ────────────────────────────────────────────────────
POSTGRES_DB=contecflow
POSTGRES_USER=contecflow
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
# Puerto publicado en el HOST. Se ata a 127.0.0.1 a propósito: con `5434:5432`
# Docker publica en 0.0.0.0 y la base queda accesible desde toda la red local.
# 5434 (no 5432) para no chocar con un Postgres instalado en la máquina.
POSTGRES_PORT=127.0.0.1:5434

# ── Redis [bootstrap] ─────────────────────────────────────────────────────────
# Obligatorio en producción: sin él cada worker de uvicorn lleva sus propios
# contadores de rate limit (los límites se multiplican por N) y los tickets de
# WebSocket viven en memoria del proceso, así que un WS que caiga en otro worker
# falla.
REDIS_URL=redis://127.0.0.1:6381/0
REDIS_PORT=127.0.0.1:6381
REDIS_MAXMEMORY=256mb

# ── Almacén S3 local (versitygw) [bootstrap] ──────────────────────────────────
# Permite ejercitar en local la MISMA ruta de código que en producción usa AWS
# S3. Antes no era posible y los documentos caían siempre al sistema de ficheros.
# Va bajo perfil (`docker compose --profile s3 up -d`; también arranca con
# `--profile app`). Las variables conservan el nombre `MINIO_*` de cuando el
# servidor era MinIO, para no romper ningún `.env` existente.
MINIO_ROOT_USER=contecflow
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_minio_password
MINIO_BUCKET=contecflow-documents
# 9003: el 9000 lo publica contecweb y el 9002 contecmind.
MINIO_PORT=127.0.0.1:9003

# ── Endpoint S3 [runtime] ─────────────────────────────────────────────────────
# Vacío = AWS S3. Con el stack de Docker, `http://s3:9000` (lo inyecta el
# propio compose en los servicios de la app; aquí sólo hace falta si ejecutas la
# app en local contra el almacén del contenedor: http://127.0.0.1:9003).
# AWS_S3_ENDPOINT_URL=
# Direccionamiento por ruta: obligatorio en versitygw, MinIO y compatibles. Si se deja sin
# definir se deduce (con endpoint propio → por ruta; contra AWS → el suyo).
# AWS_S3_FORCE_PATH_STYLE=

# ── Puertos y escalado de los servicios de la app [deploy] ────────────────────
# Sólo aplican con `--profile app`.
WEB_PORT=127.0.0.1:8080
API_WORKERS=4
WORKER_CONCURRENCY=4
# PROMETHEUS_PORT=127.0.0.1:9090

# ── Bot de Microsoft Teams (opcional) [runtime] ───────────────────────────────
# `TEAMS_BOT_APP_ID` es el id de aplicación del bot. Sin él, el receptor de
# comandos entrantes devuelve 503 en vez de aceptar peticiones que no puede
# verificar.
# TEAMS_BOT_APP_ID=
#
# De dónde salen las claves públicas con las que se verifica la FIRMA del bearer
# entrante, y qué emisor tiene que declarar. Los valores por defecto son los de
# la nube pública de Microsoft y no hace falta tocarlos; están aquí porque las
# nubes soberanas —government, China— publican en otro dominio, y con la URL a
# fuego el bot no se podría desplegar ahí.
# TEAMS_BOT_OPENID_METADATA_URL=https://login.botframework.com/v1/.well-known/openidconfiguration
# TEAMS_BOT_ISSUER=https://api.botframework.com

# ── SSO enterprise (opcional) [ui-managed] — Settings → Credenciales → MS Graph
# AZURE_AD_TENANT_ID=
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=

# ── Entrada a la empresa (tenant) [deploy] ────────────────────────────────────
# Cada maquina elige UNO: email_selector (correo + selector si pertenece a
# varias; por defecto) | subdomain (<slug>.TENANT_ROOT_DOMAIN o dominio propio)
# | org_field (el login pide el codigo de la empresa).
TENANT_ENTRY_MODE=email_selector
TENANT_ROOT_DOMAIN=
TENANT_SELECTION_TOKEN_MINUTES=5

# ── Puertos (docker-compose) [bootstrap] ──────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443

# ══════════════════════════════════════════════════════════════════════════════
# Variables no listadas arriba (revisa app/core/config.py y config_groups/):
#
#   [ui-managed]  health/, semantic/, password_policy/* → Settings → Config. dinámica
#                 smtp/, twilio/, stripe/, docusign/, adobe_sign/, webhooks/ → Settings → Credenciales
#
#   [bootstrap]   SENTRY_DSN, OTEL_*, METRICS_*, ALLOWED_ORIGINS, KMS_*, WEBAUTHN_*,
#                 RATE_LIMIT_DEFAULT, BCRYPT_ROUNDS, CELERY_*_TIME_LIMIT
#
# Para el inventario completo: docs/CONFIG_MIGRATION_INVENTORY.md
# ══════════════════════════════════════════════════════════════════════════════
