# ══════════════════════════════════════════════════════════════════════════════
# Clarive PSA — Variables de entorno
# Copia este archivo a .env y rellena los valores
# NUNCA comitas .env al repositorio — está en .gitignore
# ══════════════════════════════════════════════════════════════════════════════

# ── Base de datos ──────────────────────────────────────────────────────────────
# SQLite (desarrollo):
DATABASE_URL=sqlite:///./clarive.db
# PostgreSQL (producción):
# DATABASE_URL=postgresql://clarive:PASSWORD@localhost:5432/clarive

# ── Seguridad ──────────────────────────────────────────────────────────────────
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_secure_random_key_min_32_chars
ALGORITHM=HS256
# Access token: 15-60 min recommended for production; 480 max for dev convenience
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Refresh token: 7 days recommended; 30 max. Shorter reduces breach window.
REFRESH_TOKEN_EXPIRE_DAYS=7
SUPERADMIN_EMAIL=admin@company.com
SUPERADMIN_PASSWORD=CHANGE_ME_strong_password
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
CLIENT_PORTAL_SECRET=CHANGE_ME_generate_a_secure_random_key
WEBHOOK_SECRET=CHANGE_ME_generate_a_secure_random_key

# ── CORS ───────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── SSO OAuth ──────────────────────────────────────────────────────────────────
ALLOW_LOCAL_LOGIN=true
MICROSOFT_OAUTH_BASE=https://login.microsoftonline.com
GOOGLE_OAUTH_BASE=https://accounts.google.com
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token


# ── AI providers (opcional) ────────────────────────────────────────────────────
ANTHROPIC_API_URL=https://api.anthropic.com/v1
OPENAI_API_URL=https://api.openai.com/v1
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
DEEPSEEK_API_URL=https://api.deepseek.com/v1
GROQ_API_URL=https://api.groq.com/openai/v1
MISTRAL_API_URL=https://api.mistral.ai/v1
OLLAMA_BASE_URL=http://localhost:11434
# Azure OpenAI: reemplaza YOUR_RESOURCE y YOUR_DEPLOYMENT con tus valores de Azure
AZURE_OPENAI_API_URL=https://YOUR_RESOURCE.openai.azure.com/openai/deployments/YOUR_DEPLOYMENT
# Modelo IA de fallback (se usa si no hay proveedor configurado en BD)
# Ejemplos: claude-haiku-4-5 | gpt-4o-mini | gemini-2.0-flash | llama-3.3-70b-versatile
NEXUS_AI_MODEL=claude-haiku-4-5

# ── Contabilidad (opcional) ─────────────────────────────────────────────────────
XERO_API_BASE=https://api.xero.com/api.xro/2.0
QB_API_BASE=https://quickbooks.api.intuit.com/v3/company

# ── URLs ───────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api/v1
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ── Storage ────────────────────────────────────────────────────────────────────
PDF_STORAGE_PATH=./storage/pdfs

# ── AWS S3 (para Document Management) ──────────────────────────────────────────
# Deja vacÍos para deshabilitar S3 (usa almacenamiento local)
AWS_S3_BUCKET=
AWS_REGION=eu-west-1
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
S3_URL_EXPIRATION_HOURS=24

# ── Notifications (Slack + Email) ───────────────────────────────────────────────
SLACK_WEBHOOK_URL=
NOTIFICATION_EMAIL_FROM=alerts@nexuspm.local

# ── Imputation Settings (Document & Time Tracking) ───────────────────────────────
DEFAULT_IMPUTATION_LOCKOUT_DAYS=14
DEFAULT_TIMEZONE=Europe/Madrid
DEFAULT_LANGUAGE=es
DEFAULT_CURRENCY=EUR

# ── Reglas de negocio ──────────────────────────────────────────────────────────
DEFAULT_TAX_RATE=21.0
MIN_PASSWORD_LENGTH=8
# Genera con: python -c "import secrets; print(secrets.token_urlsafe(16))"
DEFAULT_USER_PASSWORD=CHANGE_ME_default_onboarding_password
DEFAULT_WORKING_HOURS_PER_DAY=8.0
DEFAULT_WEEKLY_CAPACITY_HOURS=40.0
DEFAULT_VACATION_DAYS_PER_YEAR=23

# ── SLA (horas) ────────────────────────────────────────────────────────────────
SLA_P1_RESPONSE_HOURS=1.0
SLA_P1_RESOLUTION_HOURS=4.0
SLA_P2_RESPONSE_HOURS=4.0
SLA_P2_RESOLUTION_HOURS=8.0
SLA_P3_RESPONSE_HOURS=8.0
SLA_P3_RESOLUTION_HOURS=24.0
SLA_P4_RESPONSE_HOURS=24.0
SLA_P4_RESOLUTION_HOURS=72.0

# ── Entorno ────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
DEFAULT_PROJECT_TYPE=consulting
DEFAULT_BILLING_TYPE=time_material

# ── PostgreSQL (para docker-compose) ──────────────────────────────────────────
POSTGRES_DB=clarive
POSTGRES_USER=clarive
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password

# ── SSO enterprise (opcional) ─────────────────────────────────────────────────
# AZURE_AD_TENANT_ID=
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=

# ── Puertos (docker-compose) ──────────────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443
