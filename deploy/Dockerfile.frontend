# Frontend (Vite/React → nginx) — Contecflow PSA
# Build context: frontend/.  Build: docker build -f deploy/Dockerfile.frontend -t contecflow-frontend ./frontend
#
# NOTA: build-no-verificada en el entorno de auditoría (sin Docker). Revisar en un host con Docker.
FROM node:20-alpine AS build

WORKDIR /app
# Lockfile presente (package-lock.json) → npm ci reproducible.
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
# La config de nginx (cabeceras de seguridad + SPA fallback) ya vive en el repo.
COPY nginx.frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
