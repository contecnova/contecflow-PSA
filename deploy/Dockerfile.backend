# Backend (FastAPI + Celery) — Contecflow PSA
# Build context: repo root. La construye el compose (`x-app` → api, worker, beat y migrate;
# `./setup.sh docker` / `setup.bat docker`); a mano:
#   docker build -f deploy/Dockerfile.backend -t contecflow-api:local .
#
# Auditoría 22-11-2026 (01 B4):
# - Imagen base fijable por digest sin tocar el fichero:
#     docker build --build-arg PYTHON_IMAGE=python:3.12-slim@sha256:<digest> ...
#   (el digest de hoy: `docker buildx imagetools inspect python:3.12-slim`). En
#   producción, fijarlo en CI; aquí queda la etiqueta para que el build local no
#   dependa de un digest que caduca con cada parche de seguridad de Debian.
# - Sin `curl`: los healthchecks del compose usan Python (`urllib`), no hace falta.
# - Sin HEALTHCHECK en la imagen a propósito: la misma imagen corre la API, el worker,
#   el beat y la migración, y solo la API escucha en :8000. Cada servicio declara el
#   suyo en docker-compose.yml (la API: GET /health).
ARG PYTHON_IMAGE=python:3.12-slim
FROM ${PYTHON_IMAGE} AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# psycopg2-binary y cryptography traen wheels: no hacen falta paquetes del sistema.

# Instala dependencias primero para aprovechar la caché de capas.
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
# Dependencias ML opcionales (forecasting/anomalías): descomenta si el despliegue las usa.
# COPY requirements-ml.txt ./
# RUN pip install --no-cache-dir -r requirements-ml.txt

COPY . .

# Ejecuta como usuario no-root.
RUN useradd --create-home --uid 10001 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

# Arranque de la API (dentro del contenedor escucha en 0.0.0.0; el compose solo
# publica el puerto en 127.0.0.1). Las migraciones las hace el servicio `migrate`
# del compose (`alembic upgrade head && python -m app.db.rls`); a mano:
#   docker compose --profile app run --rm --no-deps migrate
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
