# --- Text normalization ---
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# --- Generated / vendor files (diff=off, no merge driver) ---
# Alembic autogenerated migrations (large, machine-generated)
alembic/versions/*_autogen*.py -diff linguist-generated=true

# Lock files
package-lock.json -diff linguist-generated=true
yarn.lock          -diff linguist-generated=true
poetry.lock        -diff linguist-generated=true

# npm diagnostic output (should never be committed)
npm-ls.json        -diff linguist-generated=true

# --- Binary assets ---
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  text
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.pdf   binary
*.zip   binary
*.tar.gz binary
*.gz    binary
