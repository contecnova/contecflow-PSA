# Entorno
# El .env va versionado a proposito: el repositorio es privado y asi una
# maquina nueva clona y arranca con la misma configuracion. Lo de cada
# maquina y lo de cada despliegue (.env.local, .env.produccion) sigue fuera.
.env.*
!.env.example
.claude/settings.local.json

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
venv/
.venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Database
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
backup_pre_fix_*.db

# Logs
*.log
logs/

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.*
!frontend/.env.example

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Docker
.docker/

# Uploads / generated files — keep dir structure, ignore contents
uploads/**
!uploads/**/.gitkeep
pdf_storage/

# Generated QA artifacts (keep only intentional markdown/csv reports)
reports/qa/*.xlsx
reports/qa/*structured_summary*.md

# Caches (belt-and-suspenders)
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage.*

# Playwright MCP browser snapshots
.playwright-mcp/

remaining_failures.txt
frontend/reports/

# Copias de scripts/backup.sh (revisión 2026-11)
/backups/

# Ficheros que genera la aplicación (PDFs…), no van al repositorio
/storage/

# Volcados de tsc versionados por error (auditoria 2026-11, #45)
frontend/ts_errors*.txt
