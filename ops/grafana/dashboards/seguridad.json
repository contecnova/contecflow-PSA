{
  "uid": "contecflow-seguridad",
  "title": "Contecflow · Seguridad",
  "description": "Logins, 401/403, errores por código del catálogo y denegaciones ABAC. Sin datos personales: todo agregado por empresa.",
  "tags": [
    "contecflow",
    "seguridad"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "empresa",
        "label": "Empresa",
        "datasource": {
          "type": "prometheus",
          "uid": "contecflow-prometheus"
        },
        "query": {
          "query": "label_values(empresa)",
          "refId": "empresa"
        },
        "definition": "label_values(empresa)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1,
        "regex": "",
        "hide": 0,
        "description": "Slug acotado de la organización (las que pasan de METRICS_TENANT_MAX van en «otras»)."
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Contecflow",
