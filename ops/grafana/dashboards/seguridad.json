          "refId": "A",
          "expr": "sum(increase(contecflow_logins_total{empresa=~\"$empresa\",resultado=\"correcto\"}[1h]))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
