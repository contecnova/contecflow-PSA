        "type": "query",
        "name": "empresa",
        "label": "Empresa",
        "datasource": {
          "type": "prometheus",
          "uid": "contecflow-prometheus"
        },
        "query": {
          "query": "label_values(empresa)",
          "refId": "empresa"
        },
        "definition": "label_values(empresa)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
